{
  "name": "flightphp/fleact",
  "description": "🚀 Fleact is a quick and easy React starter template with a FlightPHP backend 💻🌐✨",
  "license": "MIT",
  "type": "project",
  "require": {
    "php": ">=7.4",
    "flightphp/core": "^3.15"
  },
  "scripts": {
    "build": [
      "composer install --no-dev -o",
      "php -r \"if (!is_dir('node_modules')) system('pnpm i');\"",
      "npm run build",
      "composer archive"
    ]
  },
  "archive": {
    "exclude": [
      "node_modules",
      "scripts",
      ".editorconfig",
      ".eslintrc.json",
      ".gitignore",
      ".git",
      "biome.json",
      "composer.*",
      "LICENSE",
      "package-lock.json",
      "package.json",
      "README.md",
      "rollup.config.js",
      "jsconfig.json",
      "pnpm-*",
      "main.js",
      "*.jsx",
      "*.tsx",
      "*.map",
      ".env.dist",
      "globals.d.ts",
      "tsconfig.json",
      "env.d.ts",
      "*.module.css"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
